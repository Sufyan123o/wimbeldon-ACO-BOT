# Wimbledon Ticket Monitor - Environment Variables
# Copy this file to .env and fill in your values.

# ── Wimbledon Account ─────────────────────────────────────────────────────────
LOGIN_EMAIL=your_wimbledon_email@example.com
LOGIN_PASSWORD=your_wimbledon_password

# ── CapSolver (https://capsolver.com) ────────────────────────────────────────
API_KEY=your_capsolver_api_key

# ── Discord Webhooks ─────────────────────────────────────────────────────────
# Primary channel: receives restock alerts and purchase confirmations
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_RESTOCK_WEBHOOK

# Operational channel: receives startup pings, DataDome bans, session errors
DISCORD_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_LOG_WEBHOOK

# ── Proxies (optional) ───────────────────────────────────────────────────────
# One proxy per line.  Supported formats:
#   IP:PORT
#   IP:PORT:USERNAME:PASSWORD
#
# PROXIES=
# 1.2.3.4:8080
# 5.6.7.8:3128:user:pass
